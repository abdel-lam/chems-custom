<odoo>

    <template id="report_invoice_document_inherit" inherit_id="account.report_invoice_document">
    
        <xpath expr="//div[@name='due_date']" position="replace"/>
        <xpath expr="//div[@id='payment_term']" position="replace"/>

        <xpath expr="//table[@name='invoice_line_table']//td[@name='account_invoice_line_name']" position="replace">
            <td name="account_invoice_line_name">
                <t t-if="line.product_id" />
                    <span t-field="line.product_id.name" t-options="{'widget': 'text'}"/>
                </t>
                <t t-else="">
                    <span t-field="line.name" t-options="{'widget': 'text'}"/>
                </t>
            </td>
        </xpath>

    </template>
</odoo>
